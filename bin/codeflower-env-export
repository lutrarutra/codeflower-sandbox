#!/bin/sh
# Writes a readable recipe of the environments installed in the project,
# so they can be recreated or turned into a new image.
set -eu

state=/codeflower-state
venv="${VIRTUAL_ENV:-$state/env/venv}"
out="$state/env/exports"
mkdir -p "$out"

uv pip freeze --python "$venv/bin/python" > "$out/venv-requirements.txt"

for prefix in "$state"/env/venvs/*/; do
  if [ -x "$prefix/bin/python" ]; then
    uv pip freeze --python "$prefix/bin/python" > "$out/uv-venv-$(basename "$prefix")-requirements.txt"
  fi
done

for prefix in "${CONDA_ENVS_DIRS:-$state/env/conda}"/*/; do
  if [ -d "$prefix/conda-meta" ]; then
    conda env export --no-builds -p "$prefix" > "$out/conda-$(basename "$prefix").yml"
  fi
done

date -u +%Y-%m-%dT%H:%M:%SZ > "$out/exported-at"
echo "Environment recipe written to $out"
