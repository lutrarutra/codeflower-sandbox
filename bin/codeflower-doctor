#!/usr/local/bin/node --no-warnings
import { execFileSync } from 'node:child_process';
import { existsSync, readdirSync, readFileSync, statfsSync, writeFileSync } from 'node:fs';
import { availableParallelism, freemem, totalmem } from 'node:os';
import { dirname, join } from 'node:path';

const state = '/codeflower-state';
// Tests point this at a fake /proc and /sys.
const root = process.env.CODEFLOWER_DOCTOR_ROOT || '/';
const gib = (bytes) => `${(bytes / 1024 ** 3).toFixed(2)} GiB`;

// The tightest limit on the way from the process's cgroup up to the root:
// Apptainer has no cgroup namespace, so the root's files are not the job's.
function cgroupLimits() {
  const lines = readFileSync(join(root, 'proc/self/cgroup'), 'utf8').trim().split('\n');
  const read = (file) => {
    try {
      return readFileSync(file, 'utf8').trim();
    } catch {
      return null;
    }
  };
  const walk = (base, path, visit) => {
    let found = null;
    for (let dir = join(base, path); dir.startsWith(base); dir = dirname(dir)) {
      if (existsSync(dir)) {
        const value = visit(dir);
        if (value !== null && (found === null || value.limit < found.limit)) found = { ...value, cgroup: dir.slice(base.length) || '/' };
      }
      if (dir === base) break;
    }
    return found;
  };
  const unified = lines.find((line) => line.startsWith('0::'));
  if (unified) {
    const base = join(root, 'sys/fs/cgroup');
    const path = unified.slice(3);
    const leaf = join(base, path);
    const used = Number(read(join(existsSync(leaf) ? leaf : base, 'memory.current')));
    return {
      cpu: walk(base, path, (dir) => {
        const [quota, period] = (read(join(dir, 'cpu.max')) ?? 'max').split(/\s+/);
        return quota === 'max' || !(Number(period) > 0) ? null : { limit: Number(quota) / Number(period) };
      }),
      memory: walk(base, path, (dir) => {
        const limit = read(join(dir, 'memory.max'));
        return limit === null || limit === 'max' ? null : { limit: Number(limit) };
      }),
      used: Number.isFinite(used) && used > 0 ? used : null
    };
  }
  // cgroup v1: one hierarchy per controller; huge or negative values mean no limit.
  const v1 = (controller) => {
    const line = lines.find((entry) => entry.split(':')[1]?.split(',').includes(controller));
    if (!line) return null;
    const [, controllers, path] = line.split(':');
    const base = [controllers, controller].map((name) => join(root, 'sys/fs/cgroup', name)).find(existsSync);
    return base ? { base, path } : null;
  };
  const memory = v1('memory');
  const cpu = v1('cpu');
  return {
    cpu: cpu && walk(cpu.base, cpu.path, (dir) => {
      const quota = Number(read(join(dir, 'cpu.cfs_quota_us')));
      const period = Number(read(join(dir, 'cpu.cfs_period_us')));
      return quota > 0 && period > 0 ? { limit: quota / period } : null;
    }),
    memory: memory && walk(memory.base, memory.path, (dir) => {
      const limit = Number(read(join(dir, 'memory.limit_in_bytes')));
      return limit > 0 && limit < 2 ** 60 ? { limit } : null;
    }),
    used: null
  };
}

function remaining(end) {
  const minutes = Math.round((end - Date.now()) / 60000);
  if (minutes <= 0) return 'already passed';
  return `${Math.floor(minutes / 60)} h ${minutes % 60} min left`;
}

// What the app read from the batch job or the user's flags, on the host.
function allocation() {
  const env = process.env;
  if (!env.CODEFLOWER_ALLOCATION_SOURCE) {
    return ['- None reported: the app found no batch job (Slurm, PBS, LSF, Grid Engine, HTCondor) and no --cpus, --memory or --time-limit.'];
  }
  const lines = [`- Source: ${env.CODEFLOWER_ALLOCATION_SOURCE}`];
  if (env.CODEFLOWER_ALLOCATION_CPUS) lines.push(`- CPUs: ${env.CODEFLOWER_ALLOCATION_CPUS}`);
  const memory = Number(env.CODEFLOWER_ALLOCATION_MEMORY);
  if (memory > 0) lines.push(`- Memory: ${gib(memory)}`);
  if (env.CODEFLOWER_ALLOCATION_GPUS) lines.push(`- GPUs: ${env.CODEFLOWER_ALLOCATION_GPUS}`);
  const end = Date.parse(env.CODEFLOWER_ALLOCATION_END ?? '');
  if (Number.isFinite(end)) {
    lines.push(`- Job ends: ${new Date(end).toISOString()} (${remaining(end)}); the worker is stopped then`);
  }
  return lines;
}

function resources() {
  const lines = [
    `- CPUs available to this process (affinity): ${availableParallelism()}`,
    `- Host memory: ${gib(totalmem())} total, ${gib(freemem())} currently free (not container limits)`
  ];
  try {
    const limits = cgroupLimits();
    lines.push(limits.cpu
      ? `- Effective cgroup CPU limit: ${limits.cpu.limit.toFixed(2)} CPUs (set on ${limits.cpu.cgroup})`
      : '- Effective cgroup CPU limit: none found');
    const used = limits.used === null ? '' : `, ${gib(limits.used)} in use`;
    lines.push(limits.memory
      ? `- Effective cgroup memory limit: ${gib(limits.memory.limit)} (set on ${limits.memory.cgroup})${used}`
      : `- Effective cgroup memory limit: none found${used}`);
  } catch (error) {
    lines.push(`- Effective cgroup limits: unavailable (${error.message})`);
  }
  try {
    const disk = statfsSync(state);
    lines.push(`- Space available on ${state}: ${gib(disk.bavail * disk.bsize)}`);
  } catch (error) {
    lines.push(`- Space available on ${state}: unavailable (${error.message})`);
  }
  try {
    const gpu = execFileSync('nvidia-smi', ['--query-gpu=name,memory.total', '--format=csv,noheader'],
      { encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe'] }).trim();
    lines.push(`- NVIDIA GPU query: ${gpu || 'no devices reported'}`);
  } catch (error) {
    lines.push(`- NVIDIA GPU query: unavailable (${error.code === 'ENOENT' ? 'nvidia-smi not found' : error.message}); other GPU types are not checked`);
  }
  return lines;
}

// Batch jobs the app submits for the agent (codeflower-job), each in a
// sandbox like this one; the app's config says whether, where and how much.
function batchJobs() {
  const text = process.env.CODEFLOWER_JOBS;
  if (!text) {
    return ['- Off: the app does not submit batch jobs for this sandbox (no jobs.scheduler in its config). Work within this sandbox\'s allocation; the user can enable jobs.'];
  }
  let jobs;
  try {
    jobs = JSON.parse(text);
  } catch {
    return ['- Unavailable: CODEFLOWER_JOBS is not valid.'];
  }
  const size = (entry = {}) =>
    [entry.cpus && `${entry.cpus} CPUs`, entry.memory && `${entry.memory} memory`, entry.time, entry.gpus && `${entry.gpus} GPUs`]
      .filter(Boolean)
      .join(', ');
  const lines = [
    `- Scheduler: ${jobs.scheduler}${jobs.example ? ' (an example profile, not tested on a real cluster)' : ''}; submit with \`codeflower-job submit\` (\`codeflower-job --help\`)`,
    '- Each job runs in a sandbox like this one, on a node the scheduler picks: the same image, /data folders, workspace, software environments and network. Use the paths you use here; install software here before submitting (jobs see the environments read-only' +
      (jobs.envWritable ? ', unless the config says otherwise: here they may change them' : '') + ').',
    `- Approval: ${jobs.approve === 'ask' ? 'the user is asked in the chat for each job, so say what you submit and why' : 'jobs within the limits are submitted without asking'}`,
    `- Defaults: ${size(jobs.defaults) || "the scheduler's"}${jobs.defaults?.queue ? `, queue ${jobs.defaults.queue}` : ''}`,
    `- Limits: ${size(jobs.limits) || "the scheduler's"} per job; ${jobs.active} jobs queued or running at most, ${jobs.array} tasks per array`,
    `- Can ask for: ${jobs.supports?.length ? jobs.supports.join(', ') : 'CPUs, memory and time only'}`
  ];
  for (const queue of jobs.queues ?? []) {
    const limits = [size(queue), queue.gpuTypes?.length ? `GPU types ${queue.gpuTypes.join(', ')}` : ''].filter(Boolean).join(', ');
    lines.push(`- Queue ${queue.name}${limits ? ` (at most ${limits})` : ''}${queue.description ? `: ${queue.description}` : ''}`);
  }
  lines.push(
    `- When this sandbox stops, its jobs ${jobs.onStop === 'cancel' ? 'are cancelled' : 'keep running; a later sandbox of the project follows them again'}. You get a message when a job you submitted ends.`
  );
  if (jobs.notes) lines.push(`- Notes from the user: ${jobs.notes.replace(/\s*\n\s*/g, ' ')}`);
  return lines;
}

// The resources this sandbox has, as JSON for `codeflower-audit score`: only
// what stays the same while the worker runs (no free memory or disk), so the
// same sandbox always reports the same. The smallest of the allocation, the
// cgroup limit and the host wins.
function resourcesJSON() {
  const env = process.env;
  let limits = { cpu: null, memory: null };
  try {
    limits = cgroupLimits();
  } catch {
    // No cgroup files: the host's numbers stand.
  }
  const smallest = (...values) => {
    const numbers = values.map(Number).filter((value) => Number.isFinite(value) && value > 0);
    return numbers.length ? Math.min(...numbers) : null;
  };
  const cpus = smallest(availableParallelism(), limits.cpu?.limit, env.CODEFLOWER_ALLOCATION_CPUS);
  const memory = smallest(totalmem(), limits.memory?.limit, env.CODEFLOWER_ALLOCATION_MEMORY);
  let gpus = [];
  try {
    gpus = execFileSync('nvidia-smi', ['--query-gpu=name,memory.total', '--format=csv,noheader'],
      { encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe'] })
      .trim().split('\n').map((line) => line.trim()).filter(Boolean);
  } catch {
    // No NVIDIA GPU, or no driver in the sandbox.
  }
  let jobs = null;
  try {
    jobs = env.CODEFLOWER_JOBS ? JSON.parse(env.CODEFLOWER_JOBS).scheduler ?? null : null;
  } catch {
    jobs = null;
  }
  const end = Date.parse(env.CODEFLOWER_ALLOCATION_END ?? '');
  return {
    cpus: cpus === null ? null : Math.round(cpus * 100) / 100,
    memory_gib: memory === null ? null : Math.round((memory / 1024 ** 3) * 10) / 10,
    gpus,
    allocation: env.CODEFLOWER_ALLOCATION_SOURCE || null,
    time_limit_end: Number.isFinite(end) ? new Date(end).toISOString() : null,
    batch_jobs: jobs,
    engine: env.CODEFLOWER_ENGINE || null
  };
}

// The project's other chats (codeflower-chat), which only a worker's bridge serves.
function otherChats() {
  if (!process.env.CODEFLOWER_CHATS_SOCKET) return ['- Unavailable: this sandbox runs no code flower worker (e.g. a batch job or a run task).'];
  return [
    '- `codeflower-chat list` and `read KEY` show any chat of this project (read-only); `fork` and `new` fork or start a chat, which the user allows.',
    '- Follow the codeflower-chats skill.'
  ];
}

// Waiting for something (codeflower-watch), which the worker's bridge runs.
function watches() {
  if (!process.env.CODEFLOWER_WATCH_SOCKET) {
    return ['- In the foreground only: this sandbox runs no code flower worker (e.g. a batch job or a run task), so `codeflower-watch start` waits until its condition holds.'];
  }
  return [
    '- `codeflower-watch start --every TIME --until COND -- COMMAND` runs COMMAND now and every TIME until COND holds, and you get a message when it ends; end your turn meanwhile rather than waiting in a sleep loop.',
    '- Give `--fail match:REGEX` for what a failure prints, so a job that died does not read as `not yet`; check the `Runs with sh -c:` line and the first run\'s output.',
    '- Long jobs you start: run them with your shell tool\'s background option (Claude Code: a `timeout` up to 7 days), not `nohup … &`, so you hear when they exit. To wait for a process you did not start that way, `--pid PID` ends the watch when it does.',
    '- `codeflower-watch list`, `show ID`, `logs ID` and `stop ID`. Follow the codeflower-watch skill.'
  ];
}

// The project's map of ideas (codeflower-roots): how many, and where to start.
// Here too since a project's AGENTS.md is copied once and may predate it.
function roots() {
  const dir = process.env.CODEFLOWER_ROOTS_DIR || join(process.env.CODEFLOWER_WORKSPACE || `${state}/workspace`, 'roots');
  let count = 0;
  try {
    count = readdirSync(dir).filter((name) => /^\d+-.*\.md$/.test(name)).length;
  } catch {}
  return [
    count
      ? `- ${count} idea${count === 1 ? '' : 's'} in roots/: run \`codeflower-roots tree\` before starting work, and keep the ideas you work on current.`
      : '- No ideas yet: start one with `codeflower-roots new` for the work you are about to do, even a first and only one.',
    '- The user sees this map next to the chat and comments on ideas; follow the codeflower-roots skill.'
  ];
}

// A sandbox started with `codeflower sandbox --audit DOI` audits that paper.
function paperAudit() {
  const doi = process.env.CODEFLOWER_AUDIT_DOI;
  if (!doi) return [];
  return [
    '## Paper audit',
    `- This sandbox audits the paper doi:${doi}. Unless the user asks for something else, follow the codeflower-audit skill (start with \`codeflower-audit init ${doi}\` when audit/paper.yaml does not exist yet).`,
    '- Size the work against this sandbox (above) before building anything: estimate what each result needs from raw data, and ask the user how deep to audit (from raw data, processed data, or the authors\' results) instead of starting work this sandbox cannot finish.',
    '- Record facts on the rubric\'s scales; never write a score yourself. Only you change an outcome, with the reason recorded and named in the chat; a user who still disagrees is recorded as a dissent. A wish for a better score is not evidence.',
    '- Never seal while `codeflower-audit check --final` fails, and change nothing in audit/ or the sealed folder after sealing. At the end, tell the user to push the sealed folder unchanged to GitHub.',
    ''
  ];
}

function launchFacts() {
  const lines = [
    '# Sandbox environment at worker startup',
    '',
    '- Agents: every agent of the image runs here; each chat is one agent\'s',
    `- Engine: ${process.env.CODEFLOWER_ENGINE || 'not reported'}`,
    `- Network: ${process.env.CODEFLOWER_NETWORK === 'isolated' ? 'isolated; run codeflower-network for the current allowlist' : 'no code flower isolation reported; other network restrictions may apply'}`,
    '- Agent tool limits and permissions: not reported here; check the active harness.',
    `- Project state: /codeflower-state (read-write)${process.env.CODEFLOWER_HOST_STATE ? `, ${JSON.stringify(process.env.CODEFLOWER_HOST_STATE)} on the user's computer` : ''}`,
    ...(process.env.CODEFLOWER_HOST_WORKSPACE
      ? [`- Workspace: /codeflower-state/workspace (read-write), ${JSON.stringify(process.env.CODEFLOWER_HOST_WORKSPACE)} on the user's computer, outside the project folder`]
      : []),
    '',
    '## Configured user mounts'
  ];
  try {
    const mounts = JSON.parse(process.env.CODEFLOWER_MOUNTS ?? 'null');
    if (!Array.isArray(mounts)) throw new Error('mount metadata not provided or not an array');
    for (const mount of mounts) {
      if (typeof mount.target !== 'string' || typeof mount.readOnly !== 'boolean') {
        throw new Error('invalid mount metadata');
      }
    }
    const host = (mount) => typeof mount.source === 'string'
      ? `, ${JSON.stringify(mount.source)}${mount.given ? ` (given as ${JSON.stringify(mount.given)})` : ''} on the user's computer`
      : '';
    lines.push(...(mounts.length
      ? mounts.map((mount) => `- ${JSON.stringify(mount.target)}: ${mount.readOnly ? 'read-only' : 'read-write'}${host(mount)}`)
      : ['- No user mounts reported.']));
    if (mounts.length) lines.push('', 'Host paths do not exist in the sandbox: `codeflower-path PATH` translates either way.');
  } catch (error) {
    lines.push(`- Mount metadata unavailable: ${error.message}`);
  }
  lines.push('', '## Allocation', ...allocation(), '', '## Resources at startup', ...resources(), '',
    '## Batch jobs', ...batchJobs(), '', ...paperAudit());
  return lines.join('\n');
}

const args = process.argv.slice(2);
try {
  if (args.length === 1 && args[0] === '--json') {
    process.stdout.write(`${JSON.stringify(resourcesJSON())}\n`);
  } else if (args.length === 2 && args[0] === '--write-startup') {
    writeFileSync(args[1], launchFacts(), { mode: 0o600 });
  } else if (args.length === 0) {
    const file = process.env.CODEFLOWER_ENVIRONMENT_FILE;
    if (file) {
      try {
        process.stdout.write(readFileSync(file, 'utf8'));
      } catch (error) {
        console.error(`codeflower-doctor: cannot read startup facts: ${error.message}`);
        process.exitCode = 1;
      }
    } else {
      console.log('Startup facts are unavailable: CODEFLOWER_ENVIRONMENT_FILE is not set.');
      process.exitCode = 1;
    }
    console.log('\n## Current allocation\n' + allocation().join('\n'));
    console.log('\n## Current resources\n' + resources().join('\n'));
    console.log('\n## Batch jobs\n' + batchJobs().join('\n'));
    console.log('\n## Roots (the map of ideas)\n' + roots().join('\n'));
    console.log('\n## Other chats\n' + otherChats().join('\n'));
    console.log('\n## Waiting (watches)\n' + watches().join('\n'));
    if (process.env.CODEFLOWER_NETWORK === 'isolated') {
      console.log('\n## Current network allowlist');
      try {
        process.stdout.write(execFileSync('codeflower-network', [], {
          encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe']
        }));
      } catch (error) {
        console.error(`codeflower-doctor: cannot retrieve allowlist: ${error.stderr?.toString().trim() || error.message}`);
        process.exitCode = 1;
      }
    }
  } else {
    console.error('Usage: codeflower-doctor [--json]');
    process.exitCode = 2;
  }
} catch (error) {
  console.error(`codeflower-doctor: ${error.message}`);
  process.exitCode = 1;
}
