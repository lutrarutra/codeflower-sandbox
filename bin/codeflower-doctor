#!/usr/local/bin/node --no-warnings
import { execFileSync } from 'node:child_process';
import { existsSync, readFileSync, statfsSync, writeFileSync } from 'node:fs';
import { availableParallelism, freemem, totalmem } from 'node:os';
import { dirname, join } from 'node:path';

const state = '/codeflower-state';
// Tests point this at a fake /proc and /sys.
const root = process.env.CODEFLOWER_DOCTOR_ROOT || '/';
const gib = (bytes) => `${(bytes / 1024 ** 3).toFixed(2)} GiB`;

// The tightest limit on the way from the process's cgroup up to the root:
// Apptainer has no cgroup namespace, so the root's files are not the job's.
function cgroupLimits() {
  const lines = readFileSync(join(root, 'proc/self/cgroup'), 'utf8').trim().split('\n');
  const read = (file) => {
    try {
      return readFileSync(file, 'utf8').trim();
    } catch {
      return null;
    }
  };
  const walk = (base, path, visit) => {
    let found = null;
    for (let dir = join(base, path); dir.startsWith(base); dir = dirname(dir)) {
      if (existsSync(dir)) {
        const value = visit(dir);
        if (value !== null && (found === null || value.limit < found.limit)) found = { ...value, cgroup: dir.slice(base.length) || '/' };
      }
      if (dir === base) break;
    }
    return found;
  };
  const unified = lines.find((line) => line.startsWith('0::'));
  if (unified) {
    const base = join(root, 'sys/fs/cgroup');
    const path = unified.slice(3);
    const leaf = join(base, path);
    const used = Number(read(join(existsSync(leaf) ? leaf : base, 'memory.current')));
    return {
      cpu: walk(base, path, (dir) => {
        const [quota, period] = (read(join(dir, 'cpu.max')) ?? 'max').split(/\s+/);
        return quota === 'max' || !(Number(period) > 0) ? null : { limit: Number(quota) / Number(period) };
      }),
      memory: walk(base, path, (dir) => {
        const limit = read(join(dir, 'memory.max'));
        return limit === null || limit === 'max' ? null : { limit: Number(limit) };
      }),
      used: Number.isFinite(used) && used > 0 ? used : null
    };
  }
  // cgroup v1: one hierarchy per controller; huge or negative values mean no limit.
  const v1 = (controller) => {
    const line = lines.find((entry) => entry.split(':')[1]?.split(',').includes(controller));
    if (!line) return null;
    const [, controllers, path] = line.split(':');
    const base = [controllers, controller].map((name) => join(root, 'sys/fs/cgroup', name)).find(existsSync);
    return base ? { base, path } : null;
  };
  const memory = v1('memory');
  const cpu = v1('cpu');
  return {
    cpu: cpu && walk(cpu.base, cpu.path, (dir) => {
      const quota = Number(read(join(dir, 'cpu.cfs_quota_us')));
      const period = Number(read(join(dir, 'cpu.cfs_period_us')));
      return quota > 0 && period > 0 ? { limit: quota / period } : null;
    }),
    memory: memory && walk(memory.base, memory.path, (dir) => {
      const limit = Number(read(join(dir, 'memory.limit_in_bytes')));
      return limit > 0 && limit < 2 ** 60 ? { limit } : null;
    }),
    used: null
  };
}

function remaining(end) {
  const minutes = Math.round((end - Date.now()) / 60000);
  if (minutes <= 0) return 'already passed';
  return `${Math.floor(minutes / 60)} h ${minutes % 60} min left`;
}

// What the launcher read from the batch job or the user's flags, on the host.
function allocation() {
  const env = process.env;
  if (!env.CODEFLOWER_ALLOCATION_SOURCE) {
    return ['- None reported: the launcher found no batch job (Slurm, PBS, LSF, Grid Engine, HTCondor) and no --cpus, --memory or --time-limit.'];
  }
  const lines = [`- Source: ${env.CODEFLOWER_ALLOCATION_SOURCE}`];
  if (env.CODEFLOWER_ALLOCATION_CPUS) lines.push(`- CPUs: ${env.CODEFLOWER_ALLOCATION_CPUS}`);
  const memory = Number(env.CODEFLOWER_ALLOCATION_MEMORY);
  if (memory > 0) lines.push(`- Memory: ${gib(memory)}`);
  if (env.CODEFLOWER_ALLOCATION_GPUS) lines.push(`- GPUs: ${env.CODEFLOWER_ALLOCATION_GPUS}`);
  const end = Date.parse(env.CODEFLOWER_ALLOCATION_END ?? '');
  if (Number.isFinite(end)) {
    lines.push(`- Job ends: ${new Date(end).toISOString()} (${remaining(end)}); the worker is stopped then`);
  }
  return lines;
}

function resources() {
  const lines = [
    `- CPUs available to this process (affinity): ${availableParallelism()}`,
    `- Host memory: ${gib(totalmem())} total, ${gib(freemem())} currently free (not container limits)`
  ];
  try {
    const limits = cgroupLimits();
    lines.push(limits.cpu
      ? `- Effective cgroup CPU limit: ${limits.cpu.limit.toFixed(2)} CPUs (set on ${limits.cpu.cgroup})`
      : '- Effective cgroup CPU limit: none found');
    const used = limits.used === null ? '' : `, ${gib(limits.used)} in use`;
    lines.push(limits.memory
      ? `- Effective cgroup memory limit: ${gib(limits.memory.limit)} (set on ${limits.memory.cgroup})${used}`
      : `- Effective cgroup memory limit: none found${used}`);
  } catch (error) {
    lines.push(`- Effective cgroup limits: unavailable (${error.message})`);
  }
  try {
    const disk = statfsSync(state);
    lines.push(`- Space available on ${state}: ${gib(disk.bavail * disk.bsize)}`);
  } catch (error) {
    lines.push(`- Space available on ${state}: unavailable (${error.message})`);
  }
  try {
    const gpu = execFileSync('nvidia-smi', ['--query-gpu=name,memory.total', '--format=csv,noheader'],
      { encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe'] }).trim();
    lines.push(`- NVIDIA GPU query: ${gpu || 'no devices reported'}`);
  } catch (error) {
    lines.push(`- NVIDIA GPU query: unavailable (${error.code === 'ENOENT' ? 'nvidia-smi not found' : error.message}); other GPU types are not checked`);
  }
  return lines;
}

function launchFacts() {
  const lines = [
    '# Sandbox environment at worker startup',
    '',
    `- Agent: ${process.env.CODEFLOWER_AGENT || 'not reported'}`,
    `- Engine: ${process.env.CODEFLOWER_ENGINE || 'not reported'}`,
    `- Network: ${process.env.CODEFLOWER_NETWORK === 'isolated' ? 'isolated; run codeflower-network for the current allowlist' : 'no code flower isolation reported; other network restrictions may apply'}`,
    '- Agent tool limits and permissions: not reported here; check the active harness.',
    '- Project state: /codeflower-state (read-write)',
    '',
    '## Configured user mounts'
  ];
  try {
    const mounts = JSON.parse(process.env.CODEFLOWER_MOUNTS ?? 'null');
    if (!Array.isArray(mounts)) throw new Error('mount metadata not provided or not an array');
    for (const mount of mounts) {
      if (typeof mount.target !== 'string' || typeof mount.readOnly !== 'boolean') {
        throw new Error('invalid mount metadata');
      }
    }
    lines.push(...(mounts.length
      ? mounts.map((mount) => `- ${JSON.stringify(mount.target)}: ${mount.readOnly ? 'read-only' : 'read-write'}`)
      : ['- No user mounts reported.']));
  } catch (error) {
    lines.push(`- Mount metadata unavailable: ${error.message}`);
  }
  lines.push('', '## Allocation', ...allocation(), '', '## Resources at startup', ...resources(), '');
  return lines.join('\n');
}

const args = process.argv.slice(2);
try {
  if (args.length === 2 && args[0] === '--write-startup') {
    writeFileSync(args[1], launchFacts(), { mode: 0o600 });
  } else if (args.length === 0) {
    const file = process.env.CODEFLOWER_ENVIRONMENT_FILE;
    if (file) {
      try {
        process.stdout.write(readFileSync(file, 'utf8'));
      } catch (error) {
        console.error(`codeflower-doctor: cannot read startup facts: ${error.message}`);
        process.exitCode = 1;
      }
    } else {
      console.log('Startup facts are unavailable: CODEFLOWER_ENVIRONMENT_FILE is not set.');
      process.exitCode = 1;
    }
    console.log('\n## Current allocation\n' + allocation().join('\n'));
    console.log('\n## Current resources\n' + resources().join('\n'));
    if (process.env.CODEFLOWER_NETWORK === 'isolated') {
      console.log('\n## Current network allowlist');
      try {
        process.stdout.write(execFileSync('codeflower-network', [], {
          encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe']
        }));
      } catch (error) {
        console.error(`codeflower-doctor: cannot retrieve allowlist: ${error.stderr?.toString().trim() || error.message}`);
        process.exitCode = 1;
      }
    }
  } else {
    console.error('Usage: codeflower-doctor');
    process.exitCode = 2;
  }
} catch (error) {
  console.error(`codeflower-doctor: ${error.message}`);
  process.exitCode = 1;
}
