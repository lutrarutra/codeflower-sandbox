#!/usr/bin/env python3
"""Runs a command in a pseudo-terminal and relays it over stdin/stdout.

The bridge uses it for sign-in commands (e.g. `claude auth login`) that need
a real terminal. The size comes from COLUMNS and LINES.
"""
import fcntl
import os
import pty
import select
import struct
import sys
import termios


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: codeflower-pty COMMAND [ARG...]", file=sys.stderr)
        return 2
    columns = int(os.environ.get("COLUMNS", "100"))
    lines = int(os.environ.get("LINES", "30"))
    pid, master = pty.fork()
    if pid == 0:
        os.environ.setdefault("TERM", "xterm-256color")
        os.execvp(sys.argv[1], sys.argv[1:])
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", lines, columns, 0, 0))

    stdin_open = True
    status = None
    while True:
        readable, _, _ = select.select([master] + ([0] if stdin_open else []), [], [], 0.2)
        if master in readable:
            try:
                data = os.read(master, 65536)
            except OSError:
                data = b""
            if not data:
                break
            os.write(1, data)
        if stdin_open and 0 in readable:
            data = os.read(0, 65536)
            if data:
                os.write(master, data)
            else:
                stdin_open = False
        # Some systems never report end-of-file on the master side, so watch
        # the child directly once it is quiet.
        if not readable:
            finished, child_status = os.waitpid(pid, os.WNOHANG)
            if finished:
                status = child_status
                break
    if status is None:
        _, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    return 128 + os.WTERMSIG(status)


if __name__ == "__main__":
    sys.exit(main())
