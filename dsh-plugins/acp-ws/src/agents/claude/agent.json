{
  "id": "claude",
  "name": "Claude Code",
  "description": "Anthropic. Sign in with a Claude subscription or an API key.",
  "color": "orange",
  "icon": {
    "file": "icon.svg"
  },
  "order": 10,
  "launch": "@agentclientprotocol/claude-agent-acp/dist/index.js",
  "home": {
    "variable": "CLAUDE_CONFIG_DIR",
    "path": "harness/claude"
  },
  "env": {
    "CLAUDE_CODE_EXECUTABLE": "/opt/codeflower/agents/claude/claude"
  },
  "credentialVariables": [
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "CLAUDE_CODE_OAUTH_TOKEN"
  ],
  "providerHosts": [
    "api.anthropic.com",
    "claude.ai",
    "platform.claude.com",
    "console.anthropic.com"
  ],
  "goal": {
    "maxLength": 4000
  },
  "costEstimate": true,
  "subagents": {
    "adapter": "air-draft",
    "reports": {
      "model": true,
      "effort": true,
      "usage": "none",
      "result": true
    },
    "settings": {
      "model": {
        "kind": "session-meta",
        "path": [
          "claudeCode",
          "options",
          "env",
          "CLAUDE_CODE_SUBAGENT_MODEL"
        ],
        "applies": "session"
      }
    }
  },
  "plugins": {
    "kinds": [
      "marketplace",
      "github",
      "git",
      "path"
    ],
    "catalogs": [
      {
        "name": "claude-plugins-official",
        "source": "github:anthropics/claude-plugins-official"
      }
    ],
    "hosts": [
      "github.com",
      "codeload.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "api.github.com"
    ]
  }
}
