{
  "id": "codex",
  "name": "Codex",
  "description": "OpenAI. Sign in with ChatGPT or an OpenAI API key.",
  "color": "teal",
  "order": 20,
  "launch": "@agentclientprotocol/codex-acp/dist/index.js",
  "home": {
    "variable": "CODEX_HOME",
    "path": "harness/codex"
  },
  "env": {
    "NO_BROWSER": "1",
    "CODEX_CONFIG": "{\"features.multi_agent_v2\":true}"
  },
  "credentialVariables": [
    "OPENAI_API_KEY",
    "CODEX_API_KEY"
  ],
  "container": {
    "userNamespaces": true
  },
  "providerHosts": [
    "api.openai.com",
    "auth.openai.com",
    "chatgpt.com"
  ],
  "files": {
    "config.toml": "# Written once by codeflower; edit freely.\nsandbox_mode = \"danger-full-access\"\napproval_policy = \"on-request\"\n"
  },
  "goal": {
    "maxLength": 4000
  },
  "subagents": {
    "adapter": "air-draft",
    "reports": {
      "model": true,
      "effort": false,
      "usage": "context",
      "result": true
    },
    "settings": {
      "model": {
        "kind": "json-env",
        "variable": "CODEX_CONFIG",
        "key": "agents.default_subagent_model",
        "applies": "restart"
      },
      "effort": {
        "kind": "json-env",
        "variable": "CODEX_CONFIG",
        "key": "agents.default_subagent_reasoning_effort",
        "applies": "restart"
      }
    }
  }
}
